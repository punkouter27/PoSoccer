<?xml version="1.0" encoding="utf-8"?>
<!--
  PoSoccer main menu (2026-11-09 redesign, user request: the 16 face characters
  to choose from, and four modes).

  Top to bottom: title; the mode bar (1v1, 4v4, 1v1 CUP, 4v4 CUP); the lineup
  row (Blue seats VS Red seats) or, in a cup mode, a line about the bracket; the
  4 x 4 grid of characters; PLAY / RANDOM; the options row (ELO, CARDS, GALLERY,
  sound). SETTINGS lives on the chrome's top-right button on every screen.

  WHAT IS IN HERE AND WHAT IS NOT. Everything with a fixed identity is declared
  here and resolved by name in Agent_MainMenu. Everything whose SHAPE depends on
  data - a tile per character, a seat per squad place - is built in C# into the
  named containers below. No inline `style=`: every appearance decision lives in
  PoSoccerTheme.uss, and Agent_EditMode_Theme fails the build if a class used
  here is not defined there.

  Names are an API. Agent_MainMenu resolves each one and disables the menu with
  a log line if any is missing, so renaming an element here without renaming it
  there ships a blank screen.
-->
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="safe" class="screen screen--menu">

        <ui:VisualElement name="header" class="stack-center enter">
            <ui:Label name="title" text="PoSoccer" class="title menu__title" />
            <!--
              Shown only when NO character carries a usable brain (a clone without
              LFS, or the day the observation contract changes).
              Agent_MainMenu.RefreshBrainNote toggles `is-shown`.
            -->
            <ui:Label name="brain-note" text="No trained brains installed — every player uses the scripted bot" class="menu__brain-note" />
        </ui:VisualElement>

        <ui:VisualElement name="modes" class="menu__modes">
            <ui:Button name="mode-1v1" text="1v1" class="btn menu__mode" />
            <ui:Button name="mode-4v4" text="4v4" class="btn menu__mode" />
            <ui:Button name="mode-cup1" text="1v1 CUP" class="btn menu__mode" />
            <ui:Button name="mode-cup4" text="4v4 CUP" class="btn menu__mode" />
        </ui:VisualElement>

        <ui:VisualElement name="lineup" class="menu__lineup">
            <ui:VisualElement name="side-blue" class="menu__side">
                <ui:Label name="name-blue" text="BLUE" class="menu__side-name menu__team-name--blue" />
                <ui:VisualElement name="seats-blue" class="menu__seats" />
            </ui:VisualElement>
            <ui:Label name="versus" text="VS" class="menu__versus" />
            <ui:VisualElement name="side-red" class="menu__side">
                <ui:Label name="name-red" text="RED" class="menu__side-name menu__team-name--red" />
                <ui:VisualElement name="seats-red" class="menu__seats" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:Label name="cup-info" class="text-muted menu__cup-info" />

        <ui:VisualElement name="grid" class="menu__grid" />

        <ui:VisualElement name="footer" class="stack-center enter">
            <ui:Label name="pitch-note" class="text-muted menu__note" />
            <ui:VisualElement name="play-row" class="row menu__play-row">
                <ui:Button name="play" text="PLAY" class="btn btn--play menu__play" />
                <ui:Button name="random" text="RANDOM" class="btn menu__random" />
            </ui:VisualElement>
            <ui:VisualElement name="options" class="row menu__options" />
            <ui:Label name="back-hint" text="press back again to exit" class="text-muted menu__hint" />
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
